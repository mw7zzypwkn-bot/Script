	local function refresh(instant)
		local curTh = getTheme()
		local on = getter()
		row.BackgroundColor3 = curTh.RowBg
		local tGoal = on and curTh.Accent or curTh.TrackOff
		local kGoal = on and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
