local function clearMap(tbl)
	for k, hl in pairs(tbl) do
		if hl then pcall(function() hl:Destroy() end) end
		tbl[k] = nil
	end
end

local function makeHighlight(adornee, name, fillColor, outlineColor)
	if not adornee then return nil end
	local hl = Instance.new("Highlight")
	hl.Name = name
	hl.FillColor = fillColor
	hl.OutlineColor = outlineColor
	hl.FillTransparency = 0.42
	hl.OutlineTransparency = 0
	hl.Adornee = adornee
	hl.Parent = workspace
	return hl
end

local function scanBomb()
	local carrier, bombObj = nil, nil

	for _, plr in ipairs(Players:GetPlayers()) do
		local c = getChar(plr)
		if c then
			for _, item in ipairs(c:GetChildren()) do
				if (item:IsA("Tool") or item:IsA("BasePart") or item:IsA("Model")) and isBombItem(item) then
					carrier = plr
					bombObj = item
					break
				end
			end
		end
		if not carrier then
			local bp = plr:FindFirstChild("Backpack")
			if bp then
				for _, item in ipairs(bp:GetChildren()) do
					if item:IsA("Tool") and isBombItem(item) then
						carrier = plr
						bombObj = item
						break
					end
				end
			end
		end
		if carrier then break end
	end

	if not bombObj then
		for _, desc in ipairs(workspace:GetDescendants()) do
			if (desc:IsA("Tool") or desc:IsA("BasePart") or desc:IsA("Model")) and isBombItem(desc) then
				bombObj = desc
				break
			end
		end
	end

	State.BombCarrier = carrier
	State.BombObject = bombObj

	if carrier and carrier ~= State.LastNotifiedCarrier then
		State.LastNotifiedCarrier = carrier
		pushBombAlert("القنبلة الآن مع: " .. carrier.Name)
	elseif not carrier then
		State.LastNotifiedCarrier = nil
	end
end

local function updateESP()
	scanBomb()
	local th = getTheme()

	clearMap(State.BombHighlights)
	if Config.BombESP then
		local target = (State.BombCarrier and getChar(State.BombCarrier)) or State.BombObject
		if target then
			State.BombHighlights[target] = makeHighlight(target, "AX_BombESP", th.Accent, th.White)
		end
	end

	clearMap(State.PlayerHighlights)
	if Config.PlayerESP then
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer and plr ~= State.BombCarrier then
				local char = getChar(plr)
				local hum = getHum(plr)
				if char and hum and hum.Health > 0 then
					State.PlayerHighlights[plr] = makeHighlight(char, "AX_PlayerESP", th.White, th.Accent)
				end
			end
		end
	end
end

