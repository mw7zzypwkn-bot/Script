local function getBombPosition()
	if State.BombCarrier then
		local r = getRoot(State.BombCarrier)
		if r then return r.Position end
	end
	if State.BombObject then
		if State.BombObject:IsA("BasePart") then
			return State.BombObject.Position
		elseif State.BombObject:IsA("Model") then
			if State.BombObject.PrimaryPart then
				return State.BombObject.PrimaryPart.Position
			end
			local p = State.BombObject:FindFirstChildWhichIsA("BasePart", true)
			if p then return p.Position end
		end
	end
	return nil
end

local function findNearestPlayer()
	local myRoot = getRoot(LocalPlayer)
	if not myRoot then return nil end

	local bestPlr, bestDist = nil, math.huge
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			local r = getRoot(plr)
			local h = getHum(plr)
			if r and h and h.Health > 0 then
				local d = (r.Position - myRoot.Position).Magnitude
				if d < bestDist then
					bestDist = d
					bestPlr = plr
				end
			end
		end
	end
	return bestPlr
end

local function equipBombTool()
	local char = getChar(LocalPlayer)
	local hum = getHum(LocalPlayer)
	local bp = LocalPlayer:FindFirstChild("Backpack")
	if not char or not hum or not bp then return end

	for _, tool in ipairs(bp:GetChildren()) do
		if tool:IsA("Tool") and isBombItem(tool) then
			hum:EquipTool(tool)
			break
		end
	end
end

local function teleportToBombCarrier()
	local myRoot = getRoot(LocalPlayer)
	if not myRoot then return end
	local carrierRoot = State.BombCarrier and getRoot(State.BombCarrier)
	if carrierRoot then
		myRoot.CFrame = carrierRoot.CFrame * CFrame.new(0, 0, 3)
	else
		local bPos = getBombPosition()
		if bPos then
			myRoot.CFrame = CFrame.new(bPos + Vector3.new(0, 2, 0))
		end
	end
end

local function saveSafeSpot()
	local myRoot = getRoot(LocalPlayer)
	if myRoot then
		State.SafeCFrame = myRoot.CFrame
		pushBombAlert("تم حفظ نقطة الأمان (Safe Spot)")
	end
end

local function stepMovementAndBomb()
	local myRoot = getRoot(LocalPlayer)
	local myHum = getHum(LocalPlayer)
	if not myRoot or not myHum or myHum.Health <= 0 then return end

	myHum.WalkSpeed = Config.SuperSpeed and Config.WalkSpeed or 16
	myHum.UseJumpPower = true
	myHum.JumpPower = Config.HighJump and Config.JumpPower or 50

	if Config.AutoEquipBomb and State.BombCarrier == LocalPlayer then
		equipBombTool()
	end

	if Config.PassToNearest and State.BombCarrier == LocalPlayer then
		equipBombTool()
		local nearest = findNearestPlayer()
		local nRoot = nearest and getRoot(nearest)
		if nRoot then
			myHum:MoveTo(Vector3.new(nRoot.Position.X, myRoot.Position.Y, nRoot.Position.Z))
			return
		end
	end

	if Config.AutoEscape and State.BombCarrier ~= LocalPlayer then
		local bombPos = getBombPosition()
		if bombPos then
			local dist = (myRoot.Position - bombPos).Magnitude
			if dist <= Config.EscapeDistance then
				local dir = myRoot.Position - bombPos
				if dir.Magnitude < 0.1 then
					dir = Vector3.new(1, 0, 0)
				end
				local fleePos = myRoot.Position + dir.Unit * (Config.EscapeDistance + 10)
				myHum:MoveTo(Vector3.new(fleePos.X, myRoot.Position.Y, fleePos.Z))
			end
		end
	end
end

