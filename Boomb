		if instant then
			track.BackgroundColor3 = tGoal
			knob.Position = kGoal
		else
			TweenService:Create(track, TweenInfo.new(0.14), { BackgroundColor3 = tGoal }):Play()
			TweenService:Create(knob, TweenInfo.new(0.14), { Position = kGoal }):Play()
		end
	end

	refresh(true)
	table.insert(State.SyncCallbacks, function() refresh(true) end)

	track.MouseButton1Click:Connect(function()
		setter(not getter())
		refresh(false)
	end)

	table.insert(State.AllRows, { Row = row, Text = labelText, IsThemeMenu = false })
end

local function addSliderRow(parent, labelText, minVal, maxVal, order, getter, setter)
	local th = getTheme()
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, 0, 0, 44)
	row.LayoutOrder = order
	row.BackgroundColor3 = th.RowBg
	row.Parent = parent
	Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(0.65, 0, 0, 18)
	lbl.Position = UDim2.new(0, 12, 0, 3)
	lbl.BackgroundTransparency = 1
	lbl.Text = labelText
	lbl.TextColor3 = th.White
	lbl.Font = Enum.Font.GothamSemibold
	lbl.TextSize = 11
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Parent = row

	local valLbl = Instance.new("TextLabel")
	valLbl.Size = UDim2.new(0.28, 0, 0, 18)
	valLbl.Position = UDim2.new(0.7, 0, 0, 3)
	valLbl.BackgroundTransparency = 1
	valLbl.Text = tostring(getter())
	valLbl.TextColor3 = th.Accent
	valLbl.Font = Enum.Font.GothamBold
	valLbl.TextSize = 11
	valLbl.TextXAlignment = Enum.TextXAlignment.Right
	valLbl.Parent = row

	local barBg = Instance.new("TextButton")
	barBg.Size = UDim2.new(1, -24, 0, 7)
	barBg.Position = UDim2.new(0, 12, 0, 27)
	barBg.BackgroundColor3 = th.TrackOff
	barBg.Text = ""
	barBg.AutoButtonColor = false
	barBg.Parent = row
	Instance.new("UICorner", barBg).CornerRadius = UDim.new(1, 0)

	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(0, 0, 1, 0)
	fill.BackgroundColor3 = th.Accent
	fill.BorderSizePixel = 0
	fill.Parent = barBg
	Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

	local function syncSlider()
		local curTh = getTheme()
		local v = math.clamp(getter(), minVal, maxVal)
		local alpha = (v - minVal) / math.max(1, (maxVal - minVal))
		row.BackgroundColor3 = curTh.RowBg
		barBg.BackgroundColor3 = curTh.TrackOff
		fill.BackgroundColor3 = curTh.Accent
		valLbl.TextColor3 = curTh.Accent
		valLbl.Text = tostring(math.floor(v))
		fill.Size = UDim2.new(alpha, 0, 1, 0)
	end

	syncSlider()
	table.insert(State.SyncCallbacks, syncSlider)

	local sliding = false
	local function updateFromX(xPos)
		local rel = math.clamp((xPos - barBg.AbsolutePosition.X) / math.max(1, barBg.AbsoluteSize.X), 0, 1)
		local newVal = math.floor(minVal + rel * (maxVal - minVal))
		setter(newVal)
		syncSlider()
	end

	barBg.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			sliding = true
			updateFromX(input.Position.X)
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					sliding = false
				end
			end)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			updateFromX(input.Position.X)
		end
	end)

	table.insert(State.AllRows, { Row = row, Text = labelText, IsThemeMenu = false })
end

