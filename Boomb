SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
	local q = string.lower(SearchBox.Text)
	if q == "" then
		for _, p in pairs(tabPages) do
			p.Visible = false
		end
		if activeTab and tabPages[activeTab] then
			tabPages[activeTab].Visible = true
		end
		for _, item in ipairs(State.AllRows) do
			if not item.IsThemeMenu then
				item.Row.Visible = true
			end
		end
		return
	end

	for _, p in pairs(tabPages) do
		p.Visible = true
	end
	for _, item in ipairs(State.AllRows) do
		if not item.IsThemeMenu then
			item.Row.Visible = string.find(string.lower(item.Text), q, 1, true) ~= nil
		end
	end
end)

